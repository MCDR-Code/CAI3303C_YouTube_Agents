# Copy this file to .env and fill in real values. Never commit .env.
#
# One Prune API key per agent, so each agent has its own spend cap in Prune.
# In mock mode none of these are needed.
PRUNE_KEY_PRODUCER=
PRUNE_KEY_TREND_RESEARCHER=
PRUNE_KEY_TOPIC_STRATEGIST=
PRUNE_KEY_SCRIPTWRITER=
PRUNE_KEY_FACT_CHECKER=
PRUNE_KEY_SEO_METADATA=
PRUNE_KEY_VISUAL_DESIGNER=
PRUNE_KEY_ANALYTICS=
PRUNE_KEY_BUSINESS_MANAGER=

# Key for non-agent media calls (text-to-speech and image generation) in real mode.
PRUNE_KEY_MEDIA=

# YouTube (real mode only). OAuth client file downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_API_KEY=
